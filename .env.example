# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sarvam AI
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# LLM Provider: "sarvam" (default), "openai", or "groq"
LLM_PROVIDER=sarvam

# OpenAI (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Groq Cloud (only needed when LLM_PROVIDER=groq)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Language switching: "policy" (stable, recommended) or "sarvam" (use each
# raw Sarvam language detection for TTS immediately)
LANGUAGE_SWITCH_MODE=policy

# Langfuse Observability (optional — set LANGFUSE_TRACING_ENABLED=false to disable)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TIMEOUT=10
